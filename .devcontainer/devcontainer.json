{
    "name": "zoisite",
    "image": "mcr.microsoft.com/devcontainers/base:0-focal",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.codex,target=/tmp/codex-host,readonly,type=bind"
    ],
    "remoteUser": "root",
    "overrideFeatureInstallOrder": [
        "ghcr.io/rocker-org/devcontainer-features/apt-packages",
        "ghcr.io/devcontainers/features/rust",
        "ghcr.io/devcontainers-community/features/llvm",
        "ghcr.io/devcontainers/features/node"
    ],
    "features": {
        "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
            "packages": [
                "pkg-config",
                "libzstd-dev"
            ]
        },
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/rapidsai/devcontainers/features/rust:25": {
            "version": "stable"
        },
        "ghcr.io/devcontainers-community/features/llvm": {
            "version": "21"
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "bash .devcontainer/post-start.sh"
}
